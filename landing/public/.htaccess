# Apache config for the built site.
#
# Measured against the live origin before this file existed: the engine was
# served as gzip, 1,870,985 bytes, with no Cache-Control and cf-cache-status:
# DYNAMIC. The same bytes are 1,261,660 as brotli. Cloudflare in front of an
# origin passes the origin's encoding through and only emits brotli itself when
# `br` is the sole accepted encoding, which no real browser sends — so the
# origin has to serve brotli for anyone to receive it.
#
# The build writes a .br and .gz next to every compressible asset. These rules
# hand out the pre-compressed body when the client accepts it, which is both
# smaller than Apache's on-the-fly output and free at request time.

<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Prefer brotli, then gzip, and only when the pre-compressed file exists.
  RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*br(\s|,|;|$)
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.*)$ $1.br [QSA,L,E=ZIPP_ENC:br]

  RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*gzip(\s|,|;|$)
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L,E=ZIPP_ENC:gzip]
</IfModule>

<IfModule mod_headers.c>
  # A pre-compressed body must never be handed to mod_deflate again.
  SetEnvIf Request_URI "\.(br|gz)$" no-gzip=1
  Header set Content-Encoding "br"   env=ZIPP_ENC_br
  Header set Content-Encoding "gzip" env=ZIPP_ENC_gzip
  Header append Vary Accept-Encoding
</IfModule>

# The rewrite leaves the request pointing at a .br/.gz file, so the type has to
# be restored explicitly or the browser is told it is downloading an archive.
# `application/wasm` in particular is required for WebAssembly.instantiateStreaming;
# without it the generated glue logs a warning and falls back to the slower
# buffering path.
<IfModule mod_headers.c>
  <FilesMatch "\.wasm\.(br|gz)$">
    Header set Content-Type "application/wasm"
  </FilesMatch>
  <FilesMatch "\.js\.(br|gz)$">
    Header set Content-Type "text/javascript; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.css\.(br|gz)$">
    Header set Content-Type "text/css; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.html\.(br|gz)$">
    Header set Content-Type "text/html; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints everything under assets/, so those are safe to pin hard.
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^playground\.worker-[A-Za-z0-9_-]+\.js(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The engine filename is NOT content-hashed (it is copied verbatim out of
  # public/), so `immutable` would pin a stale build in browsers that already
  # hold one. A week with revalidation is the honest ceiling until the artifact
  # carries a hash in its name.
  <FilesMatch "\.wasm(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  <FilesMatch "\.html(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# The generated .d.ts files ship because they sit in public/wasm/. They are for
# editors consuming the published package and are never fetched by the page.
<FilesMatch "\.d\.ts$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

# Single-page-application fallback: the router owns unknown paths.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
