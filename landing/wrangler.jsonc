{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zipp-js-engine",
  "compatibility_date": "2026-08-30",
  "main": "./worker/index.js",
  "assets": {
    "run_worker_first": ["/api/*"],
    // The React app has no client-side routes, and the documentation pages are real
    // files, so unknown URLs get a genuine 404 (served from 404.html) instead of a
    // soft-404 copy of the home page.
    "not_found_handling": "404-page"
  }
}
