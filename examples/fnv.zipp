// FNV-1a 32-bit hash — the canonical use case for u32 wrapping arithmetic.
// (ZIPP has no string byte-access yet, so we hash an array of byte values.)
fn fnv32(data: [i64]): u32 {
    let h = u32(2166136261);          // FNV offset basis
    let i = 0;
    while (i < len(data)) {
        h = (h ^ u32(data[i])) * u32(16777619);  // XOR byte, then * FNV prime, wrapping at 32 bits
        i = i + 1;
    }
    return h;
}

fn main(): i64 {
    let hello = [104, 101, 108, 108, 111]; // "hello"
    let h = fnv32(hello);
    print(h);                                // 1335831723
    return i64(h);
}
