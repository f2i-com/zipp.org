// Bitwise / shift operators (PLAN.md §5.4 native integers).
fn main(): i64 {
    let flags = (1 << 0) | (1 << 3);   // 0b1001 = 9
    let masked = flags & 12;           // 0b1001 & 0b1100 = 0b1000 = 8
    let x = masked ^ 255;              // 8 ^ 255 = 247
    print(flags);
    print(masked);
    print(x);
    return x;
}
