// Builtin math: abs/min/max/pow (integers), sqrt/floor/ceil (floats).
fn main(): i64 {
    print(abs(-7));                  // 7
    print(min(3, 9));                // 3
    print(max(3, 9));                // 9
    print(pow(2, 10));               // 1024
    print(sqrt(f64(3 * 3 + 4 * 4))); // 5  (3-4-5 triangle)
    print(floor(2.7));               // 2
    print(ceil(2.1));                // 3
    return 0;
}
