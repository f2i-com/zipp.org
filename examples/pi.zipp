// Leibniz series for pi: f64 math with i64<->f64 casts.
// Off-chain only — `--prove` rejects this (the zk profile is integer-only).
fn main(): f64 {
    let pi = 0.0;
    let sign = 1.0;
    let i = 0;
    while (i < 1000000) {
        let denom = f64(2 * i + 1);
        pi = pi + sign / denom;
        sign = -sign;
        i = i + 1;
    }
    pi = pi * 4.0;
    print(pi);
    return pi;
}
