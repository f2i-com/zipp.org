// FizzBuzz 1..=20 — exercises for loops, %, else-if chains, strings, and print.
fn main(): i64 {
    for (let i = 1; i <= 20; i = i + 1) {
        if (i % 15 == 0) {
            print("FizzBuzz");
        } else if (i % 3 == 0) {
            print("Fizz");
        } else if (i % 5 == 0) {
            print("Buzz");
        } else {
            print(i);
        }
    }
    return 0;
}
