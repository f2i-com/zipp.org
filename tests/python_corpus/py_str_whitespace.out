== characters that are not whitespace
'\x00' False '\x00x\x00' '\x00x\x00' '\x00x\x00' ['\x00x\x00'] ['a\x00b'] '\x00x\x00'
'\x1b' False '\x1bx\x1b' '\x1bx\x1b' '\x1bx\x1b' ['\x1bx\x1b'] ['a\x1bb'] '\x1bx\x1b'
'!' False '!x!' '!x!' '!x!' ['!x!'] ['a!b'] '!x!'
'\x7f' False '\x7fx\x7f' '\x7fx\x7f' '\x7fx\x7f' ['\x7fx\x7f'] ['a\x7fb'] '\x7fx\x7f'
'\x84' False '\x84x\x84' '\x84x\x84' '\x84x\x84' ['\x84x\x84'] ['a\x84b'] '\x84x\x84'
'\x86' False '\x86x\x86' '\x86x\x86' '\x86x\x86' ['\x86x\x86'] ['a\x86b'] '\x86x\x86'
'\u180e' False '\u180ex\u180e' '\u180ex\u180e' '\u180ex\u180e' ['\u180ex\u180e'] ['a\u180eb'] '\u180ex\u180e'
'\u200b' False '\u200bx\u200b' '\u200bx\u200b' '\u200bx\u200b' ['\u200bx\u200b'] ['a\u200bb'] '\u200bx\u200b'
'\u200c' False '\u200cx\u200c' '\u200cx\u200c' '\u200cx\u200c' ['\u200cx\u200c'] ['a\u200cb'] '\u200cx\u200c'
'\u200d' False '\u200dx\u200d' '\u200dx\u200d' '\u200dx\u200d' ['\u200dx\u200d'] ['a\u200db'] '\u200dx\u200d'
'\u2060' False '\u2060x\u2060' '\u2060x\u2060' '\u2060x\u2060' ['\u2060x\u2060'] ['a\u2060b'] '\u2060x\u2060'
'\ufeff' False '\ufeffx\ufeff' '\ufeffx\ufeff' '\ufeffx\ufeff' ['\ufeffx\ufeff'] ['a\ufeffb'] '\ufeffx\ufeff'
'a' False 'axa' 'axa' 'axa' ['axa'] ['aab'] 'axa'
== ASCII receivers
strip 'Alpha beta\x1dGAMMA'
lstrip 'Alpha beta\x1dGAMMA \x1e\x1f\n'
rstrip '\x1c\t  Alpha beta\x1dGAMMA'
split ['Alpha', 'beta', 'GAMMA']
unchanged ('abc', 'abc', 'abc')
all white ''
all white l ''
all white r ''
empty ('', '', '')
empty split []
white split []
inner kept 'a \x1c b'
one side '\x1fabc'
other side 'abc\x1f'
one char ('', '', 'a', 'a', 'a')
== receivers beyond ASCII
strip 'caf\xe9 \u2028na\xefve\ufeff'
lstrip 'caf\xe9 \u2028na\xefve\ufeff\u2003\x85'
rstrip '\x85\u3000\xa0caf\xe9 \u2028na\xefve\ufeff'
split ['caf\xe9', 'na\xefve\ufeff']
bom kept '\ufeffx\ufeff'
bom split ['a\ufeffb', 'c']
nel 'x'
nel split ['a', 'b']
astral '\U0001f600 \U0001f601'
astral split ['\U0001f600', '\U0001f601']
unchanged ('caf\xe9', 'caf\xe9', 'caf\xe9')
all white ('', [])
== a lone surrogate in the receiver
strip '\ud800 x'
lstrip '\ud800 x\x85\x1f'
rstrip '\x1c \ud800 x'
split ['\ud800', 'x']
isspace (False, False)
== explicit None, and character sets
strip(None) 'a'
lstrip(None) 'a \x1f'
rstrip(None) '\x1c a'
strip(chars) '\x1c a \x1f'
strip(sep) ' a '
lstrip(chars) 'abcxx'
rstrip(chars) 'xxabc'
strip(wide) 'abc'
