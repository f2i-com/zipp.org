-1 ['a', 'b', 'c', 'd'] ['a', 'b', 'c', 'd'] ['a', 'b', 'c', 'd'] ['a', 'b', 'c', 'd']
0 ['a\x1db \x85 c\x1ed\x1f'] ['\x1ca\x1db \x85 c\x1ed'] ['a\x1db \x85 c\x1ed\x1f'] ['\x1ca\x1db \x85 c\x1ed']
1 ['a', 'b \x85 c\x1ed\x1f'] ['\x1ca\x1db \x85 c', 'd'] ['a', 'b \x85 c\x1ed\x1f'] ['\x1ca\x1db \x85 c', 'd']
2 ['a', 'b', 'c\x1ed\x1f'] ['\x1ca\x1db', 'c', 'd'] ['a', 'b', 'c\x1ed\x1f'] ['\x1ca\x1db', 'c', 'd']
3 ['a', 'b', 'c', 'd\x1f'] ['\x1ca', 'b', 'c', 'd'] ['a', 'b', 'c', 'd\x1f'] ['\x1ca', 'b', 'c', 'd']
