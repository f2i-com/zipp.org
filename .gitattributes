*.sh text eol=lf
tools/test262-corrections/** text eol=lf
# Unified patches encode empty context lines as one space; preserve that syntax.
tools/test262-corrections/*.patch whitespace=-blank-at-eol,-blank-at-eof
bench/pgo-training/** text eol=lf

# Preserve upstream parser sources/snapshots, including generated whitespace.
crates/rustpython-parser-fork/** text eol=lf
crates/rustpython-parser-fork/README.md whitespace=-blank-at-eol
crates/rustpython-parser-fork/src/lib.rs whitespace=-blank-at-eol
crates/rustpython-parser-fork/src/parser.rs whitespace=-blank-at-eol
crates/rustpython-parser-fork/src/python.rs whitespace=-blank-at-eol

# The WASM engine pairs are hash-checked against their manifests; never convert line endings.
landing/public/playground-runtime/** -text
landing/public/wasm/** -text

# Model-plugin Python sources are hashed byte for byte by their plugin.json, and
# each model.json pins that manifest again, so a CRLF checkout would make every
# bundled fixture refuse to load. Keep this tree LF, and the checkpoints exact.
crates/zipp-wasm/model-plugins/** text eol=lf
crates/zipp-wasm/model-plugins/**/*.safetensors -text

# Compiled WebAssembly: build output of crates/zipp-wasm/rust, committed the way
# gpu-lab/wasm/kernels.wasm always has been. A line-ending conversion silently
# corrupts the module, and the rule above would otherwise claim the ones under
# model-plugins. The wasm-bindgen .js and .d.ts beside them are text and stay
# text, so they still diff.
crates/zipp-wasm/**/*.wasm -text
