// Allocation churn: a fresh 64-element array every iteration, only the current
// one live. Without a GC this leaks ~1 GB (2M * ~520 B); with the GC it stays
// bounded. Returns sum_{i=0}^{1999999} i = 1999999000000.
fn main(): i64 {
    let n = 0;
    let i = 0;
    while (i < 2000000) {
        let a = [i; 64];
        n = n + a[i % 64];
        i = i + 1;
    }
    return n;
}
