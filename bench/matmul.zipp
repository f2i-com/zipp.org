// Naive 256x256 matrix multiply over flat f64 arrays — a dense-f64 *array*
// kernel (the JIT/LLVM array path: repeat-alloc, computed-index load/store in a
// hot triple loop). Entries are small integers (mod 10), so every product and
// sum is an EXACT f64 integer (< 2^53) — the i64 checksum is then bit-identical
// across the interpreter, --jit, --llvm and JS, regardless of FMA/reassociation.
fn main(): i64 {
    let n = 256;
    let a = [0.0; n * n];
    let b = [0.0; n * n];
    let c = [0.0; n * n];

    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n) {
            a[i * n + j] = f64((i + j) % 10);
            b[i * n + j] = f64((i * j) % 10);
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < n) {
        let j = 0;
        while (j < n) {
            let s = 0.0;
            let k = 0;
            while (k < n) {
                s = s + a[i * n + k] * b[k * n + j];
                k = k + 1;
            }
            c[i * n + j] = s;
            j = j + 1;
        }
        i = i + 1;
    }

    let sum = 0;
    i = 0;
    while (i < n * n) {
        sum = sum + i64(c[i]);
        i = i + 1;
    }
    print(sum);
    return sum;
}
