// Mandelbrot escape-time over a WIDTH x HEIGHT grid, MAX_ITER cap.
// Pure scalar kernel (i64 + f64 + casts + short-circuit &&, nested loops) —
// the canonical language-shootout benchmark, and exactly the scalar subset the
// Cranelift JIT now covers (no heap). Returns a deterministic checksum (the
// total escape-iteration count), so --jit / interpreter / Node must all agree.
fn main(): i64 {
    let width = 1000;
    let height = 1000;
    let max_iter = 256;
    let total = 0;
    let py = 0;
    while (py < height) {
        let px = 0;
        while (px < width) {
            let cx = f64(px) / f64(width) * 3.5 - 2.5;
            let cy = f64(py) / f64(height) * 2.0 - 1.0;
            let x = 0.0;
            let y = 0.0;
            let iter = 0;
            while (x * x + y * y <= 4.0 && iter < max_iter) {
                let xt = x * x - y * y + cx;
                y = 2.0 * x * y + cy;
                x = xt;
                iter = iter + 1;
            }
            total = total + iter;
            px = px + 1;
        }
        py = py + 1;
    }
    print(total);
    return total;
}
