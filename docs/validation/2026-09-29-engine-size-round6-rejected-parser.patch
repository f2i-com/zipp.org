+// A single character needs no concatenation vector. The optimizer would
+// remove that wrapper anyway; avoiding it also saves its allocation and walk.
+#[inline(never)]
+fn make_string_node(chars: &[u32], icase: bool) -> ir::Node {
+    match chars {
+        [c] => ir::Node::Char { c: *c, icase },
+        _ => ir::Node::Cat(
+            chars.iter().map(|&c| ir::Node::Char { c, icase }).collect(),
+        ),
+    }
